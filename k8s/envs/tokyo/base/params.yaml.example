# kustomize replacements의 원본으로만 쓰고 클러스터에는 적용하지 않는다.
apiVersion: v1
kind: ConfigMap
metadata:
  name: env-params
  annotations:
    config.kubernetes.io/local-config: "true"
data:
  # 도쿄 작업 공간의 model_bucket 출력값: TF_WORKSPACE=tokyo terraform -chdir=infra/terraform output -raw model_bucket
  modelBucket: ow-on-gpu-tokyo-<suffix>
