# kustomize replacements의 원본으로만 쓰고 클러스터에는 적용하지 않는다.
apiVersion: v1
kind: ConfigMap
metadata:
  name: base-params
  annotations:
    config.kubernetes.io/local-config: "true"
data:
  # 노드가 빈 뒤 회수하기까지 기다리는 시간. 네 NodePool에 같이 들어간다.
  # 30m인 이유: 웜 재시작 측정에서 파드를 지우고 다시 만드는 사이에 GPU 노드가 회수되면
  # 그 측정이 콜드 스타트가 되어 버린다. 반대로 Never로 두면 작업을 잊었을 때 GPU 노드가 계속 남는다.
  # 30분은 측정 사이의 간격을 덮으면서 방치된 노드의 비용을 30분으로 묶는 값이다.
  consolidateAfter: 30m
  # infra/terraform의 model_bucket 출력값. platform ConfigMap의 MODEL_BUCKET으로 들어간다.
  modelBucket: ow-on-gpu-<suffix>
