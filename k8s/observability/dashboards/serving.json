{
 "uid": "ow-on-gpu-serving",
 "title": "ow-on-gpu 서빙",
 "tags": [
  "ow-on-gpu",
  "vllm"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "데이터 소스",
    "type": "datasource",
    "query": "prometheus"
   },
   {
    "name": "model",
    "label": "모델",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(vllm:num_requests_running, model)",
     "refId": "model"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "모델별 지연과 부하",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "TTFT",
   "description": "vLLM이 요청을 받은 뒤 첫 토큰을 내기까지의 시간. SLO는 p99 500ms",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model) (rate(vllm:time_to_first_token_seconds_bucket{model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "{{model}} p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(vllm:time_to_first_token_seconds_bucket{model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "{{model}} p95",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, model) (rate(vllm:time_to_first_token_seconds_bucket{model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "{{model}} p99",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "ITL",
   "description": "토큰 사이의 간격. SLO는 p99 50ms",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model) (rate(vllm:inter_token_latency_seconds_bucket{model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "{{model}} p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le, model) (rate(vllm:inter_token_latency_seconds_bucket{model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "{{model}} p99",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "대기 요청 수",
   "description": "엔진의 대기열과 실행 중인 요청 수",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (vllm:num_requests_waiting{model=~\"$model\"})",
     "legendFormat": "{{model}} 대기",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (model) (vllm:num_requests_running{model=~\"$model\"})",
     "legendFormat": "{{model}} 실행 중",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "KV 캐시 사용률",
   "description": "1에 가까우면 새 요청이 대기하거나 실행 중인 요청이 선점된다",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (model) (vllm:kv_cache_usage_perc{model=~\"$model\"})",
     "legendFormat": "{{model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "MTP 수락률",
   "description": "드래프트 토큰 중 수락된 비율. speculative decoding을 켠 Qwen에만 값이 있다",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (rate(vllm:spec_decode_num_accepted_tokens_total{model=~\"$model\"}[$__rate_interval])) / sum by (model) (rate(vllm:spec_decode_num_draft_tokens_total{model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "{{model}} 전체",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (model, position) (rate(vllm:spec_decode_num_accepted_tokens_per_pos_total{model=~\"$model\"}[$__rate_interval])) / on (model) group_left sum by (model) (rate(vllm:spec_decode_num_drafts_total{model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "{{model}} 위치 {{position}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "출력 토큰 처리량",
   "description": "초당 생성 토큰 수",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (rate(vllm:generation_tokens_total{model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "{{model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "대기열에서 보낸 시간",
   "description": "요청이 엔진의 대기열에 머문 시간",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 17
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model) (rate(vllm:request_queue_time_seconds_bucket{model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "{{model}} p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le, model) (rate(vllm:request_queue_time_seconds_bucket{model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "{{model}} p99",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "선점과 거절",
   "description": "KV 캐시가 모자라 실행 중인 요청을 밀어낸 횟수와 엔진이 받지 않은 요청 수(초당)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 17
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (rate(vllm:num_preemptions_total{model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "{{model}} 선점",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (model) (rate(vllm:admission_rejections_total{model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "{{model}} 거절",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "sleep 상태",
   "description": "1인 상태가 지금 상태다. awake가 아니면 잠든 것이다",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 17
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (model, sleep_state) (vllm:engine_sleep_state{model=~\"$model\"})",
     "legendFormat": "{{model}} {{sleep_state}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "row",
   "title": "EPP (풀별)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 25
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "EPP가 본 TTFT",
   "description": "EPP가 요청을 받은 뒤 응답의 첫 Chunk를 보기까지의 시간",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, pool) (rate(llm_d_epp_request_ttft_seconds_bucket{job=\"epp\"}[$__rate_interval])))",
     "legendFormat": "{{pool}} p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le, pool) (rate(llm_d_epp_request_ttft_seconds_bucket{job=\"epp\"}[$__rate_interval])))",
     "legendFormat": "{{pool}} p99",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "우선순위별 요청 수",
   "description": "InferenceObjective의 priority별 초당 요청 수와 오류",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pool, priority) (rate(llm_d_epp_request_total{job=\"epp\"}[$__rate_interval]))",
     "legendFormat": "{{pool}} priority {{priority}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (pool, error_code) (rate(llm_d_epp_request_error_total{job=\"epp\"}[$__rate_interval]))",
     "legendFormat": "{{pool}} 오류 {{error_code}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "EPP가 본 대기열과 KV 캐시",
   "description": "EPP가 vLLM 지표에서 읽은 값. 포화 판단의 근거다",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (pool) (llm_d_epp_average_queue_size{job=\"epp\"})",
     "legendFormat": "{{pool}} 대기열",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "max by (pool) (llm_d_epp_average_kv_cache_utilization{job=\"epp\"})",
     "legendFormat": "{{pool}} KV 캐시",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "max by (pool) (llm_d_epp_ready_endpoints{job=\"epp\"})",
     "legendFormat": "{{pool}} 준비된 엔드포인트",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "스케줄링 시간",
   "description": "EPP가 엔드포인트를 고르는 데 쓴 시간",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 34
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
