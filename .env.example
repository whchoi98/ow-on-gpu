# 이 저장소의 스크립트가 읽는 환경 변수입니다. 값은 비워 두고 .env에 복사해 씁니다(.env는 커밋하지 않습니다).
# 데모 계정 비밀번호(USER_PASSWORD)는 여기에도 .env에도 적지 않습니다. 필요한 명령 앞에 한 번만 붙여 넘깁니다.

# kubectl이 쓸 프로젝트 전용 kubeconfig. 공유 장비의 기본 컨텍스트를 바꾸지 않기 위해서입니다.
KUBECONFIG=infra/terraform/.kubeconfig

# 기본 리전
AWS_REGION=ap-northeast-2

# 인포그래픽 빌드(docs/infographic/build.sh)
# 나눔스퀘어OTF, D2Coding 폰트가 있는 디렉터리
INFOKIT_FONTS=
# aws-diagram 스킬의 아이콘 묶음(assets/icons.json) 경로
AWS_ICON_BUNDLE=
# Pillow와 Playwright가 설치된 파이썬 실행 파일
PYTHON=

# Claude Code 알림 웹훅(선택). 비어 있으면 알림을 보내지 않습니다.
CLAUDE_NOTIFY_WEBHOOK=
